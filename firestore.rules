rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helper Functions ────────────────────────────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Safely fetch user data. Returns null if not logged in or doc missing.
    function getUserData() {
      return (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : null;
    }
    
    // Every role the signed-in user holds (`role` and/or the `roles` array), read once per call.
    // The helpers below used to re-run `getUserData()` and a long chain of comparisons for each
    // role; for an ordinary staff member that alone exceeded Firestore's limit of 1000 evaluated
    // expressions per request, so even a simple write was refused before the real rule ran.
    function userRoles() {
      let d = getUserData();
      return d == null
        ? []
        : (d.get('roles', null) is list ? d.roles : []).concat(d.get('role', null) is string ? [d.role] : []);
    }

    function hasRole(role) {
      return request.auth != null && role in userRoles();
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isManager() {
      return request.auth != null && userRoles().hasAny(['manager', 'admin']);
    }

    function isStaff() {
      return isAuthenticated() && userRoles().hasAny([
        'admin', 'manager', 'social_worker', 'instructor', 'employee', 'logistics', 'professional_manager'
      ]);
    }

    // Manager-equivalent for shopping/inventory flows — mirrors the client's
    // `canPurchase` boundary (page.tsx), which includes logistics alongside admin/manager.
    function isShoppingManager() {
      return request.auth != null && userRoles().hasAny(['manager', 'admin', 'logistics']);
    }

    // ─── Global Rules ────────────────────────────────────────────────────────

    // Global Admin override - Give Admins full access to MOST things
    // PRIVATE MESSAGES and their alerts, and the server-only admin-password rate-limit
    // store, are excluded from this override.
    match /{document=**} {
      allow read, write: if isAdmin() && !(request.path[3] in ['messages', 'notifications', 'admin_password_attempts', 'admin_secrets']);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.auth.uid == userId || 
        isManager() ||
        (resource != null && resource.data.isPreCreated == true && resource.data.email == request.auth.token.email)
      );
    }

    // Patients collection
    match /patients/{patientId} {
      // Participants can read only their own record. Staff can read all.
      allow read: if isAuthenticated() && (
        isStaff() || 
        (getUserData() != null && getUserData().patientId == patientId)
      );
      allow write: if isStaff();
    }
    
    // ─── Attendance ──────────────────────────────────────────────────────────
    // One document per participant per day: attendance/{patientId}_{yyyy-MM-dd}. Late arrival and
    // early leave are marks on a present participant. Only staff write; a participant may read
    // only their own documents. Notes live in attendance_notes, which participants cannot read.
    function validTimeMark(m) {
      return m == null || (
        m is map &&
        m.keys().hasOnly(['at']) &&
        (m.get('at', null) == null || (m.at is string && m.at.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
      );
    }

    // The id is patientId_date. Screens that were open before that change still write the older
    // patientId_group_date id; accepting it keeps them saving until they reload (readers merge both).
    function dayAttendanceIdOk(docId, d) {
      return docId == d.patientId + '_' + d.date ||
        docId.matches('^' + d.patientId + '_.+_' + d.date + '$');
    }

    function validDayAttendance(docId, d) {
      return d.keys().hasOnly([
        'patientId', 'date', 'status', 'contextId', 'hasNote', 'source', 'derivedFrom',
        'late', 'leftEarly', 'updatedBy', 'updatedAt'
      ]) &&
        d.patientId is string && d.date is string &&
        d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        dayAttendanceIdOk(docId, d) &&
        d.status in ['present', 'absent', 'unset'] &&
        validTimeMark(d.get('late', null)) && validTimeMark(d.get('leftEarly', null));
    }

    function ownsPatient(data) {
      return getUserData() != null && data.get('patientId', '') == getUserData().get('patientId', null);
    }

    match /attendance/{docId} {
      allow read: if isAuthenticated() && (isStaff() || (resource != null && ownsPatient(resource.data)));
      allow create, update: if isStaff() && validDayAttendance(docId, request.resource.data);
      allow delete: if isStaff();
    }

    // One short line per participant per day (kind 'day') or per workshop session (kind 'session').
    match /attendance_notes/{docId} {
      allow read: if isStaff();
      allow create, update: if isStaff() &&
        request.resource.data.keys().hasOnly(['text', 'patientId', 'date', 'kind', 'sessionId', 'updatedBy', 'updatedAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 80 &&
        request.resource.data.kind in ['day', 'session'];
      allow delete: if isStaff();
    }

    // Attendance of a single workshop session: session_attendance/{sessionId}_{patientId}.
    match /session_attendance/{docId} {
      allow read: if isAuthenticated() && (isStaff() || (resource != null && ownsPatient(resource.data)));
      allow create, update: if isStaff() &&
        request.resource.data.keys().hasOnly([
          'patientId', 'date', 'sessionId', 'workshopId', 'slotId', 'programId', 'status', 'hasNote',
          'late', 'leftEarly', 'updatedBy', 'updatedAt'
        ]) &&
        request.resource.data.patientId is string && request.resource.data.sessionId is string &&
        request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        docId == request.resource.data.sessionId + '_' + request.resource.data.patientId &&
        request.resource.data.status in ['present', 'absent'] &&
        validTimeMark(request.resource.data.get('late', null)) &&
        validTimeMark(request.resource.data.get('leftEarly', null));
      allow delete: if isStaff();
    }

    // Document Requests
    match /document_requests/{docId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        (resource != null && resource.data.patientId == (getUserData() != null ? getUserData().patientId : ''))
      );
      allow write: if isAuthenticated();
    }

    // Documents (Issued)
    match /documents/{docId} {
      allow read: if isAuthenticated() && (
        isStaff() || 
        (resource != null && resource.data.patientId == (getUserData() != null ? getUserData().patientId : ''))
      );
      allow write: if isStaff();
    }

    // Staff Attendance
    match /staff_attendance/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // Absence Requests (Multiple names used in app)
    match /absence_requests/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
    }
    match /absences/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // Schedule Conflicts
    match /schedule_conflicts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
    }

    // Notifications
    match /notifications/{docId} {
      // Users can read notifications sent to them.
      // Managers can see system notifications (type == 'system') in logs.
      allow read: if isAuthenticated() && (
        (request.auth.uid in resource.data.recipientIds) ||
        (isManager() && (resource.data.type == 'system'))
      );
      allow write: if isAuthenticated();
    }

    match /messages/{docId} {
      // Accessible to participants, but also to Admins and Managers for supervision.
      // They are hidden from the global log via UI filters.
      allow read, write: if isAuthenticated() && (
        isAdmin() || isManager() ||
        (resource != null && request.auth.uid in resource.data.participants) || 
        (request.resource != null && request.auth.uid in request.resource.data.participants)
      );
    }

    // Shopping lists freeze at `settings/shopping.freezeAt.<list>` (kept in line with the real
    // lists by /api/shopping/sync-freeze). From that instant only shopping managers may change a
    // list. A missing or null boundary means "not frozen", so this is safe before it is first set.
    function isShoppingListFrozen(list) {
      let path = /databases/$(database)/documents/settings/shopping;
      let at = exists(path)
        ? get(path).data.get('freezeAt', {}).get(list == 'large' ? 'large' : 'supermarket', null)
        : null;
      return at != null && request.time >= at;
    }

    // Items without a listType (older documents) belong to the supermarket list.
    function shoppingItemList(data) {
      return data.get('listType', 'supermarket') == 'large' ? 'large' : 'supermarket';
    }

    function shoppingChangedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Shopping Requests
    match /shopping_requests/{docId} {
      allow read: if isAuthenticated();

      // Any staff member can add an item under their own name; shopping managers
      // (admin/manager/logistics) can also add on someone else's behalf (recurring
      // list import, approving a queued product request). Staff cannot add to a frozen list.
      allow create: if isShoppingManager() || (
        isStaff() &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'approved' &&
        !isShoppingListFrozen(shoppingItemList(request.resource.data))
      );

      // Any staff member can adjust, move or soft-delete an item while its list is open, but
      // nothing at all once it is frozen. Moving an item into a frozen list counts as adding to
      // it. Nobody may rewrite who requested an item or when via a plain update.
      allow update: if isShoppingManager() || (
        isStaff() &&
        request.resource.data.status in ['pending', 'approved', 'purchased', 'deleted'] &&
        !shoppingChangedKeys().hasAny(['requestedBy', 'requestedByName', 'createdAt']) &&
        !isShoppingListFrozen(shoppingItemList(resource.data)) &&
        (
          !shoppingChangedKeys().hasAny(['listType']) ||
          !isShoppingListFrozen(shoppingItemList(request.resource.data))
        )
      );

      // Only shopping managers (admin/manager/logistics) permanently delete items.
      allow delete: if isShoppingManager();
    }

    // Closed shopping cycles — an immutable history written once when a cycle is closed
    // (the live items are cleared right after, so this is the only record of that week).
    match /shopping_cycles/{docId} {
      allow read: if isStaff();
      allow create: if isShoppingManager();
      allow update, delete: if false;
    }

    // Product Pool
    match /product_pool/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isShoppingManager();
    }

    // Product Requests Queue
    match /product_requests_queue/{docId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update, delete: if isShoppingManager();
    }

    // Inventory
    match /inventory/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isShoppingManager();
    }

    // Inventory Log (append-only audit trail)
    match /inventory_log/{docId} {
      allow read: if isAuthenticated();
      allow create: if isShoppingManager();
      allow update, delete: if false;
    }

    // Receipts
    match /receipts/{docId} {
      allow read: if isAuthenticated();
      allow create: if isStaff();
      allow update, delete: if isShoppingManager();
    }

    // Server-only rate-limit store for /api/admin/verify-password — accessed
    // exclusively via the Firebase Admin SDK, which bypasses these rules.
    match /admin_password_attempts/{uid} {
      allow read, write: if false;
    }


    // Settings & Core Metadata
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager()
        || (isShoppingManager() && docId == 'shopping')
        || (isAuthenticated() && docId == 'ai_memory');
    }
    match /schedules/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    // Workshops & weekly schedule
    match /workshops/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    match /session_changes/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    match /closures/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    match /programs/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    match /groups/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    match /locations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
    match /rehab_workers/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Announcements (News)
    match /announcements/{docId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Catering Orders
    match /catering_orders/{docId} {
      allow read, write: if isAuthenticated() && (isAdmin() || hasRole('logistics'));
    }

    // Store Authorization Requests (Supermarket Purchase Requests)
    match /storeAuthorizationRequests/{docId} {
      // Anyone authenticated can create a request
      allow create: if request.auth != null;

      // User can read their own requests
      allow read: if request.auth != null && (
        resource.data.requestedBy == request.auth.uid ||
        isShoppingManager()
      );

      // Managers and logistics can update (approve/reject/edit items)
      allow update: if request.auth != null && isShoppingManager();

      // Requesters can delete their own requests, managers/logistics can delete any request
      allow delete: if request.auth != null && (
        resource.data.requestedBy == request.auth.uid ||
        isShoppingManager()
      );
    }

    // Global deny for everything else (fallback)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

